clear()
setSpeed(fast)

// Move to (0, 250) and draw Rectangle 1 (width=300, height=100)
forward(300)
right(90)
forward(100)
right(90)
forward(300)
right(90)
forward(100)
right(90)

// Move to (0, 150) and draw Rectangle 2 (width=200, height=50)
forward(200)
right(90)
forward(50)
right(90)
forward(200)
right(90)
forward(50)
right(90)