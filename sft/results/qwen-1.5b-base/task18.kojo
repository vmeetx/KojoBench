clear()
setSpeed(fast)

// Draw the rectangle
forward(100)
right(90)
forward(50)
right(90)
forward(100)
right(90)
forward(50)

// Draw the triangle
right(90)
forward(50)
right(120)
forward(50)
right(90)
forward(50)

// Draw the vertical line at the left end
forward(-100)
right(90)
forward(50)
right(90)
forward(-100)
right(90)
forward(50)