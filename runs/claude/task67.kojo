clear(); setSpeed(fast)
val r = 80
penUp(); setPosition(0, 0); penDown(); setHeading(270); left(180, r)
penUp(); setPosition(2 * r, 0); penDown(); setHeading(0); left(180, r)
penUp(); setPosition(2 * r, 2 * r); penDown(); setHeading(90); left(180, r)
penUp(); setPosition(0, 2 * r); penDown(); setHeading(180); left(180, r)
