clear()
setSpeed(fast)

// Draw outermost square
forward(200)
right(90)
forward(200)
right(90)
forward(200)
right(90)
forward(200)
right(90)

// Move to position for second square
penUp()
forward(50)
left(90)
forward(50)
penDown()

// Draw second square
forward(150)
right(90)
forward(150)
right(90)
forward(150)
right(90)
forward(150)
right(90)

// Move to position for third square
penUp()
forward(50)
left(90)
forward(50)
penDown()

// Draw third square
forward(50)
right(90)
forward(50)
right(90)
forward(50)
right(90)
forward(50)
right(90)

// Move to position for innermost square
penUp()
forward(50)
left(90)
forward(50)
penDown()

// Draw innermost square
forward(25)
right(90)
forward(25)
right(90)
