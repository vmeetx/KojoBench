clear()
setSpeed(fast)

// Draw the first square
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)
forward(100)

// Move to the starting point of the second square
penUp()
forward(100)
left(90)
forward(100)
penDown()

// Draw the second square
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)
forward(100)