clear()
setSpeed(fast)

// Draw the first square
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)
forward(100)

// Move to the starting position for the second square
penUp()
forward(100)
penDown()

// Draw the second square
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)
forward(100)

// Move to the starting position for the third square
penUp()
back(200)
right(90)
forward(100)
left(90)
penDown()

// Draw the third square
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)
forward(100)

// Move to the starting position for the fourth square
penUp()
back(100)
left(90)
forward(100)
right(90)
penDown()

// Draw the fourth square
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)
forward(100)