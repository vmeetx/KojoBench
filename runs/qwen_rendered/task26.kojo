clear()
setSpeed(fast)

// Draw the first square
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)

// Move to the starting position for the second square
penUp()
forward(100)
penDown()

// Draw the second square
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)

// Move to the starting position for the third square
penUp()
forward(100)
penDown()

// Draw the third square
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)

// Move to the starting position for the rectangle
penUp()
back(300)
left(90)
back(200)
penDown()

// Draw the rectangle
forward(600)
right(90)
forward(400)
right(90)
forward(600)
right(90)
forward(400)