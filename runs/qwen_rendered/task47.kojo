clear()
setSpeed(fast)

// Draw the first square
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)

// Move to the position for the second square and draw it
penUp()
forward(200)
penDown()
right(45)
forward(100 * math.sqrt(2))
right(135)
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)
forward(100)

// Move to the position for the third square and draw it
penUp()
left(45)
forward(200)
penDown()
right(90)
forward(100)
right(90)
forward(100)
right(90)
forward(100)
right(90)