clear()
setSpeed(fast)

// Draw the outer square
forward(400)
right(90)
forward(400)
right(90)
forward(400)
right(90)
forward(400)
right(90)

// Move to the center of the outer square
penUp()
forward(50)
left(90)
forward(50)
penDown()

// Draw the inner square
forward(300)
right(90)
forward(300)
right(90)
forward(300)
right(90)
forward(300)