clear()
setSpeed(fast)

// Draw the wide horizontal rectangle
forward(100)
right(90)
forward(20)
right(90)
forward(100)
right(90)
forward(20)
right(90)

// Move to the center of the bottom edge of the wide rectangle
penUp()
forward(50)
left(90)
forward(10)
penDown()

// Draw the narrow vertical rectangle
forward(40)
right(90)
forward(100)
right(90)
forward(40)
right(90)