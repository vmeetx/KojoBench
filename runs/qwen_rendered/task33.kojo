clear()
setSpeed(fast)

// Draw the first square
forward(200)
right(90)
forward(200)
right(90)
forward(200)
right(90)
forward(200)
right(90)

// Move to the starting position for the second square
penUp()
forward(100)
left(90)
forward(50)
penDown()

// Draw the overlapping square
forward(200)
right(90)
forward(200)
right(90)
forward(200)
right(90)
forward(200)
right(90)