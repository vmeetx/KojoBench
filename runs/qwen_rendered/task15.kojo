clear()
setSpeed(fast)

// Draw the tall narrow rectangle on the left side
forward(50)
right(90)
forward(200)
right(90)
forward(50)
right(90)
forward(200)
right(90)

// Move to the shared corner and draw the wide short rectangle along the bottom
penUp()
forward(50)
left(90)
forward(50)
penDown()
forward(150)
right(90)
forward(50)